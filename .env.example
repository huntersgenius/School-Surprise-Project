# ---------------------------------------------------------------------------
# SchoolHub — environment configuration
#
#   cp .env.example .env      then fill in the values marked CHANGE ME.
#
# .env is gitignored. Every variable below is consumed by docker-compose.yml
# (and a couple by the helper scripts), so this file is the complete list of
# everything the stack expects.
# ---------------------------------------------------------------------------

# ---- identity / naming ----------------------------------------------------
# Used as the Docker Compose project name and the container name prefix.
COMPOSE_PROJECT_NAME=schoolhub

# Human-readable name. Shown by scripts; the homepage title is in
# homepage/index.html (static HTML, not templated).
PROJECT_NAME=SchoolHub

# The hostname students type in. Avahi on the Pi answers to <hostname>.local,
# so this should match the Pi's hostname + ".local".
# NOTE: this value must ALSO be set in auth/configuration.yml (session cookie
# domain + access control rules) — Authelia does not read it from here.
SITE_HOSTNAME=schoolhub.local

# ---- host-side basics -----------------------------------------------------
TZ=UTC

# Port the reverse proxy publishes on the host. 80 in production; change it if
# something already owns port 80 on your dev machine (e.g. 8080).
HTTP_PORT=80

# Port the proxy publishes TLS on. Only routes behind login need it (Authelia
# 4.38+ won't run with an http portal URL); open content stays on HTTP_PORT.
HTTPS_PORT=443

# File ownership for the linuxserver.io images (Calibre-web, Grav).
# On the Pi and on WSL2 this is usually 1000/1000 — check with `id -u; id -g`.
#
# MUST NOT BE 0. Grav's php-fpm refuses to run as root and dies with
# "please specify user and group other than root", which shows up as a 502 on
# /news with no obvious cause. If you're running as root, leave these at 1000.
PUID=1000
PGID=1000

# ---- content locations ----------------------------------------------------
# Where the big files live. Defaults keep everything inside the repo (and
# gitignored). On the Pi you may want these on the SSD's larger partition,
# e.g. LIBRARY_DATA_DIR=/srv/schoolhub/zim
LIBRARY_DATA_DIR=./services/library/data
EBOOKS_LIBRARY_DIR=./services/ebooks/library
EBOOKS_IMPORT_DIR=./services/ebooks/import

# ---- Authelia secrets -----------------------------------------------------
# CHANGE ME — generate each one separately with:
#   openssl rand -hex 32
# (Authelia also accepts *_FILE variants pointing at a Docker secret; see
# auth/README.md if you'd rather not keep these in .env.)
AUTHELIA_SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32
AUTHELIA_STORAGE_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ---- games service --------------------------------------------------------
# Path the games app is mounted at, must match proxy/conf.d/locations/40-games.conf.
GAMES_BASE_PATH=/games
# How long a seat is held open after a player drops before the game is
# awarded to the opponent by abandonment.
GAMES_DISCONNECT_GRACE_SECONDS=90
# Rooms with no connected players are swept after this long.
GAMES_ROOM_IDLE_MINUTES=30

# ---- deploy.sh (Pi-side only, read by the script, not by compose) ---------
# The Pi's hostname; deploy.sh sets it and avahi publishes <hostname>.local.
PI_HOSTNAME=schoolhub
# Repo to clone on the Pi.
REPO_URL=https://github.com/huntersgenius/School-Surprise-Project.git
REPO_BRANCH=main
# Where the repo lives on the Pi.
INSTALL_DIR=/opt/schoolhub
# UFW will allow SSH from this address/CIDR only. CHANGE ME to your laptop's
# LAN IP (or a subnet like 192.168.1.0/24). Leave as "any" only if you accept
# SSH being reachable from the whole school network.
ADMIN_SSH_SOURCE=192.168.1.0/24
